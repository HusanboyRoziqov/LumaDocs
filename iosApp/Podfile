# Podfile for Luma Docs iOS App
# Manages dependencies for Firebase, Google Sign-In, and other frameworks

source 'https://cdn.cocoapods.org'

platform :ios, '13.0'

target 'iosApp' do
  use_frameworks!

  # Kotlin Multiplatform Pod
  pod 'composeApp', :path => '../composeApp'

  # Firebase pods
  pod 'Firebase/Core'
  pod 'Firebase/Auth'
  pod 'Firebase/Analytics'

  # Google Sign-In (Also required by composeApp)
  pod 'GoogleSignIn'

  post_install do |installer|
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= [
          '$(inherited)',
          'COCOAPODS=1',
        ]
        # Enable bitcode and other build settings
        config.build_settings['ENABLE_BITCODE'] = 'NO'
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '13.0'
      end
    end
  end
end
